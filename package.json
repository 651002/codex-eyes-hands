{
  "name": "dsh-codex-eyes-hands",
  "version": "2.2.0",
  "description": "Single DSH bundle: Codex delegation, scoped structured vision cache, crop/long-image OCR, local OCR opt-in and pixel diff.",
  "type": "commonjs",
  "license": "MIT",
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/651002/codex-eyes-hands.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "codex",
    "vision",
    "computer-use"
  ],
  "main": "plugin/index.mjs",
  "exports": {
    ".": "./plugin/index.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.svg",
    "./package.json": "./package.json",
    "./client": "./client/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "files": [
    "plugin",
    "assets",
    "locale",
    "cordis.patch.yml",
    "scripts/bridge.js",
    "LICENSE",
    "vendor/deepseek-subagent-codex",
    "README.md",
    "README.en.md",
    "docs/PLUGIN.md",
    "SKILL.md",
    "client",
    "docs/SOURCES.md"
  ],
  "scripts": {
    "build": "node scripts/build-plugin.mjs",
    "test": "node --test tests/resolver.test.mjs tests/attachments.test.mjs tests/vision.test.mjs tests/features.test.mjs tests/updates.test.mjs",
    "test:host": "node scripts/test-host.mjs"
  }
}
