{
  "name": "dsh-codex-eyes-hands",
  "version": "2.4.2",
  "description": "Codex vision and task delegation with an independent sidebar page and in-plugin upstream reminders; native DSH features are not managed.",
  "type": "commonjs",
  "license": "MIT",
  "engines": {
    "node": ">=24",
    "dsh": "0.2.2-rc.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/651002/codex-eyes-hands.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "codex",
    "vision",
    "computer-use"
  ],
  "main": "plugin/index.mjs",
  "exports": {
    ".": "./plugin/index.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.svg",
    "./package.json": "./package.json",
    "./client": "./client/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "files": [
    "plugin",
    "assets",
    "locale",
    "cordis.patch.yml",
    "scripts/bridge.js",
    "LICENSE",
    "vendor/deepseek-subagent-codex",
    "README.md",
    "README.en.md",
    "docs/PLUGIN.md",
    "SKILL.md",
    "client",
    "docs/SOURCES.md",
    "docs/CONTEXT-COMPATIBILITY.md"
  ],
  "scripts": {
    "build": "node scripts/build-plugin.mjs",
    "test": "node --test tests/resolver.test.mjs tests/attachments.test.mjs tests/vision.test.mjs tests/updates.test.mjs tests/image-messages.test.mjs",
    "test:host": "node scripts/test-host.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.2.2-rc.5",
    "@deepseek-ai/dsh-attachment-local": "0.2.2-rc.5",
    "@deepseek-ai/dsh-brand": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-sdk-protocol": "0.2.2-rc.5",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.5",
    "@deepseek-ai/dsh-subagent": "0.2.2-rc.5",
    "@deepseek-ai/dsh-timeout": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "@deepseek-ai/dsh-attachment-local": {
      "optional": true
    },
    "@deepseek-ai/dsh-brand": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-sdk-protocol": {
      "optional": true
    },
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    },
    "@deepseek-ai/dsh-subagent": {
      "optional": true
    },
    "@deepseek-ai/dsh-timeout": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    }
  }
}
